{
  "name": "writer-windows",
  "version": "0.1.0",
  "description": "A fast, private Markdown workspace for Windows.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^16.3.0",
    "mermaid": "^11.12.0"
  },
  "build": {
    "appId": "computer.writer.windows",
    "productName": "Writer",
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Writer-${version}-Windows-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
