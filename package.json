{
  "name": "writer-windows",
  "version": "0.1.0",
  "description": "A fast, private Markdown workspace for Windows.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": { "marked": "^16.3.0", "mermaid": "^11.12.0" },
  "build": {
    "appId": "computer.writer.windows",
    "productName": "Writer",
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Writer-${version}-Windows-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
